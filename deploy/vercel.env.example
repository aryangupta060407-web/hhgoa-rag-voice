# Set this in Vercel Project Settings → Environment Variables.
# Use the HTTPS hostname of the EC2 Node/tRPC API after DNS and TLS are ready.
VITE_API_BASE_URL=https://api.your-domain.example

# Never set these in Vercel: CORPUS_RETRIEVAL_TOKEN, GATEWAY_TOKEN,
# QDRANT credentials, SARVAM_API_KEY, DATABASE_URL, or any server-only secret.
