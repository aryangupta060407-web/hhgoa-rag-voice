# Copy to /opt/hhgoa-rag/.env on EC2. Do not commit the populated file.
NODE_ENV=production
PORT=3000
CORPUS_RETRIEVAL_URL=http://127.0.0.1:8080/v1/retrieve
CORPUS_RETRIEVAL_TOKEN=use-the-same-value-as-GATEWAY_TOKEN
# Bounded server-side allowance for cold or low-vCPU gateway requests; valid range is 120–1000 ms.
CORPUS_RETRIEVAL_TIMEOUT_MS=350
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-frontend-domain.example
SARVAM_API_KEY=required-only-if-voice-transcription-is-enabled
# DATABASE_URL is optional for the demo. Query history persistence is best effort.
